<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Financiación de Coches</title>
  <meta name="description" content="Compara opciones de financiación para tu coche y descubre cuánto podrías pagar al mes.">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      color: #172033;
      line-height: 1.6;
    }

    header {
      background: #102a43;
      color: white;
      padding: 20px;
    }

    nav {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
    }

    .hero {
      background: #102a43;
      color: white;
      padding: 70px 20px;
      text-align: center;
    }

    .hero h1 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 20px;
      max-width: 700px;
      margin: auto;
      color: #d9e2ec;
    }

    .container {
      max-width: 1100px;
      margin: -40px auto 60px;
      padding: 0 20px;
    }

    .calculator {
      background: white;
      border-radius: 15px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      max-width: 700px;
      margin: auto;
    }

    .calculator h2 {
      margin-bottom: 25px;
      text-align: center;
    }

    .field {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccd6e0;
      border-radius: 8px;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 15px;
      background: #1f7a4d;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #17623d;
    }

    #resultado {
      display: none;
      margin-top: 25px;
      padding: 20px;
      background: #eef8f2;
      border-radius: 10px;
      text-align: center;
    }

    #cuota {
      font-size: 32px;
      font-weight: bold;
      color: #1f7a4d;
    }

    .beneficios {
      max-width: 1000px;
      margin: 60px auto;
      padding: 0 20px;
      text-align: center;
    }

    .beneficios h2 {
      margin-bottom: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    footer {
      background: #102a43;
      color: #d9e2ec;
      text-align: center;
      padding: 30px 20px;
    }

    @media (max-width: 700px) {
      .hero h1 {
        font-size: 32px;
      }

      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <header>
    <nav>
      <div class="logo">Financiación de Coches</div>
    </nav>
  </header>

  <section class="hero">
    <h1>¿Cuánto pagarías por tu coche?</h1>
    <p>Calcula una cuota orientativa de financiación en pocos segundos.</p>
  </section>

  <main class="container">

    <section class="calculator">
      <h2>Calcula tu cuota</h2>

      <div class="field">
        <label for="precio">Precio del coche (€)</label>
        <input type="number" id="precio" placeholder="Ej. 20000">
      </div>

      <div class="field">
        <label for="entrada">Entrada (€)</label>
        <input type="number" id="entrada" placeholder="Ej. 3000">
      </div>

      <div class="field">
        <label for="plazo">Plazo (meses)</label>
        <input type="number" id="plazo" placeholder="Ej. 60">
      </div>

      <button onclick="calcular()">Calcular cuota</button>

      <div id="resultado">
        <p>Tu cuota mensual orientativa sería:</p>
        <div id="cuota"></div>
        <p>Esta cantidad es una estimación y puede variar según las condiciones de financiación.</p>
      </div>
    </section>

  </main>

  <section class="beneficios">
    <h2>¿Por qué utilizar nuestro comparador?</h2>

    <div class="cards">
      <div class="card">
        <h3>⚡ Rápido</h3>
        <p>Calcula tu cuota en pocos segundos.</p>
      </div>

      <div class="card">
        <h3>💰 Compara</h3>
        <p>Descubre diferentes opciones de financiación.</p>
      </div>

      <div class="card">
        <h3>🚗 Encuentra tu coche</h3>
        <p>Busca una financiación que se adapte a tu presupuesto.</p>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2026 Financiación de Coches</p>
  </footer>

  <script>
    function calcular() {
      const precio = Number(document.getElementById("precio").value);
      const entrada = Number(document.getElementById("entrada").value);
      const plazo = Number(document.getElementById("plazo").value);

      const capital = precio - entrada;

      if (capital <= 0 || plazo <= 0) {
        alert("Introduce valores válidos.");
        return;
      }

      const interesAnual = 0.08;
      const interesMensual = interesAnual / 12;

      const cuota =
        capital *
        (interesMensual * Math.pow(1 + interesMensual, plazo)) /
        (Math.pow(1 + interesMensual, plazo) - 1);

      document.getElementById("cuota").textContent =
        cuota.toFixed(2) + " € / mes";

      document.getElementById("resultado").style.display = "block";
    }
  </script>

</body>
</html>
